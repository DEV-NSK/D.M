generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
 OWNER
 MANAGER
 TEAM_LEAD
 EMPLOYEE
 CLIENT
}
enum MemberStatus {
 INVITED
 ACTIVE
 SUSPENDED
 DEACTIVATED
}
enum InvitationStatus {
 PENDING
 ACCEPTED
 EXPIRED
 REVOKED
}
enum ClientStatus {
 ACTIVE
 INACTIVE
 ARCHIVED
}
enum CampaignStatus {
 DRAFT
 PLANNED
 ACTIVE
 PAUSED
 COMPLETED
 CANCELLED
}
enum CampaignType {
 SOCIAL_MEDIA
 SEO
 PAID_ADVERTISING
 CONTENT_MARKETING
 EMAIL_MARKETING
 BRANDING
 WEBSITE
 INFLUENCER_MARKETING
 OTHER
}
enum AssignmentRole {
 PRIMARY
 SUPPORTING
}
model User {
 id String @id @default(cuid())
 name String
 email String @unique
 passwordHash String
 phone String?
 jobTitle String?
 bio String?
 timezone String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 memberships Membership[]
 ledTeams Team[] @relation("TeamLead")
 teamMemberships TeamMember[]
 invitations Invitation[] @relation("InvitedBy")
 activities ActivityLog[] @relation("Actor")
 passwordResets PasswordResetToken[]
 ownedClients Client[] @relation("ClientOwner")
 createdClients Client[] @relation("ClientCreator")
 createdCampaigns Campaign[] @relation("CampaignCreator")
 updatedCampaigns Campaign[] @relation("CampaignUpdater")
 clientActivities ClientActivity[] @relation("ClientActivityActor")
 campaignActivities CampaignActivity[] @relation("CampaignActivityActor")
 campaignAssignments CampaignTeamAssignment[] @relation("CampaignAssigner")
}
model Organization {
 id String @id @default(cuid())
 name String
 slug String @unique
 logoUrl String?
 timezone String @default("Asia/Kolkata")
 industry String?
 currency String @default("INR")
 language String @default("en")
 status String @default("ACTIVE")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 memberships Membership[]
 teams Team[]
 invitations Invitation[]
 activities ActivityLog[]
 clients Client[]
 clientContacts ClientContact[]
 clientActivities ClientActivity[]
 campaigns Campaign[]
 campaignObjectives CampaignObjective[]
 campaignAssignments CampaignTeamAssignment[]
 campaignActivities CampaignActivity[]
}
model Membership {
 id String @id @default(cuid())
 userId String
 organizationId String
 role Role
 status MemberStatus @default(ACTIVE)
 joinedAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id])
 organization Organization @relation(fields:[organizationId],references:[id])
 @@unique([userId,organizationId])
 @@index([organizationId,status])
}
model Team {
 id String @id @default(cuid())
 organizationId String
 name String
 description String?
 teamLeadId String?
 status String @default("ACTIVE")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id])
 teamLead User? @relation("TeamLead",fields:[teamLeadId],references:[id])
 members TeamMember[]
 campaignAssignments CampaignTeamAssignment[]
 @@unique([organizationId,name])
}

model Client {
 id String @id @default(cuid())
 organizationId String
 name String
 companyName String?
 industry String?
 websiteUrl String?
 primaryEmail String?
 primaryPhone String?
 addressLine1 String?
 addressLine2 String?
 city String?
 state String?
 postalCode String?
 countryCode String?
 timezone String?
 status ClientStatus @default(ACTIVE)
 ownerUserId String?
 notes String?
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 archivedAt DateTime?
 organization Organization @relation(fields:[organizationId],references:[id])
 owner User? @relation("ClientOwner",fields:[ownerUserId],references:[id])
 creator User @relation("ClientCreator",fields:[createdBy],references:[id])
 contacts ClientContact[]
 activities ClientActivity[]
 campaigns Campaign[]
 @@index([organizationId,status])
 @@index([organizationId,name])
}

model ClientContact {
 id String @id @default(cuid())
 organizationId String
 clientId String
 name String
 email String?
 phone String?
 jobTitle String?
 isPrimary Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id])
 client Client @relation(fields:[clientId],references:[id],onDelete:Cascade)
 @@index([organizationId,clientId])
}

model ClientActivity {
 id String @id @default(cuid())
 organizationId String
 clientId String
 actorUserId String?
 activityType String
 description String
 metadata Json?
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id])
 client Client @relation(fields:[clientId],references:[id],onDelete:Cascade)
 actor User? @relation("ClientActivityActor",fields:[actorUserId],references:[id])
 @@index([organizationId,clientId,createdAt])
}

model Campaign {
 id String @id @default(cuid())
 organizationId String
 clientId String
 name String
 slug String?
 description String?
 campaignType CampaignType
 status CampaignStatus @default(DRAFT)
 objectiveSummary String?
 startDate DateTime? @db.Date
 endDate DateTime? @db.Date
 budgetAmount Decimal? @db.Decimal(14,2)
 currencyCode String @db.Char(3)
 createdBy String
 updatedBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 archivedAt DateTime?
 organization Organization @relation(fields:[organizationId],references:[id])
 client Client @relation(fields:[clientId],references:[id])
 creator User @relation("CampaignCreator",fields:[createdBy],references:[id])
 updater User @relation("CampaignUpdater",fields:[updatedBy],references:[id])
 objectives CampaignObjective[]
 teamAssignments CampaignTeamAssignment[]
 activities CampaignActivity[]
 @@index([organizationId,status])
 @@index([organizationId,clientId])
 @@unique([organizationId,slug])
}

model CampaignObjective {
 id String @id @default(cuid())
 organizationId String
 campaignId String
 title String
 description String?
 metricType String?
 targetValue Decimal? @db.Decimal(18,4)
 unit String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id])
 campaign Campaign @relation(fields:[campaignId],references:[id],onDelete:Cascade)
 @@index([organizationId,campaignId])
}

model CampaignTeamAssignment {
 id String @id @default(cuid())
 organizationId String
 campaignId String
 teamId String
 assignmentRole AssignmentRole @default(SUPPORTING)
 assignedBy String
 assignedAt DateTime @default(now())
 removedAt DateTime?
 organization Organization @relation(fields:[organizationId],references:[id])
 campaign Campaign @relation(fields:[campaignId],references:[id])
 team Team @relation(fields:[teamId],references:[id])
 assigner User @relation("CampaignAssigner",fields:[assignedBy],references:[id])
 @@unique([campaignId,teamId])
 @@index([organizationId,campaignId])
}

model CampaignActivity {
 id String @id @default(cuid())
 organizationId String
 campaignId String
 actorUserId String?
 activityType String
 description String
 metadata Json?
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id])
 campaign Campaign @relation(fields:[campaignId],references:[id],onDelete:Cascade)
 actor User? @relation("CampaignActivityActor",fields:[actorUserId],references:[id])
 @@index([organizationId,campaignId,createdAt])
}
model TeamMember {
 id String @id @default(cuid())
 teamId String
 userId String
 createdAt DateTime @default(now())
 team Team @relation(fields:[teamId],references:[id])
 user User @relation(fields:[userId],references:[id])
 @@unique([teamId,userId])
}
model Invitation {
 id String @id @default(cuid())
 organizationId String
 email String
 role Role
 tokenHash String @unique
 status InvitationStatus @default(PENDING)
 expiresAt DateTime
 teamId String?
 invitedById String
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id])
 invitedBy User @relation("InvitedBy",fields:[invitedById],references:[id])
 @@index([organizationId,status])
}
model PasswordResetToken {
 id String @id @default(cuid())
 userId String
 tokenHash String @unique
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id])
 @@index([userId])
}
model ActivityLog {
 id String @id @default(cuid())
 organizationId String
 actorUserId String?
 action String
 entityType String
 entityId String?
 metadata Json?
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id])
 actor User? @relation("Actor",fields:[actorUserId],references:[id])
 @@index([organizationId,createdAt])
}
